###############################################################################
# Env example for Foundry scripts
#
# Copy to `.env` and fill RPC URLs only. Never commit real API keys if you
# prefer — use env vars in CI instead.
#
# Deployer keys: use `cast wallet import deployer --interactive` (see GETTING_STARTED.md).
# Optional: account label in ~/.foundry/keystores (default `deployer`).
# DEPLOYER_ACCOUNT=deployer
#
# CCIP scripts (`finalize_ccip_testnet.sh`, DeployCCIP*.s.sol): signing EOA address for `vm.startBroadcast(deployer)`.
# DEPLOYER=0x...
# Literal keystore password for `forge --password` / `finalize_ccip_testnet.sh` (do not commit).
# DEPLOYER_PASSWORD=
###############################################################################

# Local anvil RPC (when you run anvil yourself with --fork-url)
ANVIL_RPC_URL=http://127.0.0.1:8545

###############################################################################
# Fork URLs (used when starting anvil)
###############################################################################

# Use an ARCHIVE RPC endpoint (Alchemy/Infura/Tenderly/etc.) for reliable state.
AVALANCHE_FORK_URL=YOUR_AVALANCHE_ARCHIVE_RPC_URL
AVALANCHE_FORK_CHAIN_ID=43114

ARBITRUM_FORK_URL=YOUR_ARBITRUM_ARCHIVE_RPC_URL
ARBITRUM_FORK_CHAIN_ID=42161

###############################################################################
# Real testnets (RPC URLs passed via `forge script --rpc-url ...`)
###############################################################################

AVALANCHE_TESTNET_RPC_URL=YOUR_AVALANCHE_FUJI_RPC_URL
AVALANCHE_TESTNET_CHAIN_ID=43113

ARBITRUM_TESTNET_RPC_URL=YOUR_ARBITRUM_SEPOLIA_RPC_URL
ARBITRUM_TESTNET_CHAIN_ID=421614

###############################################################################
# Testnet deploy target for `DeployCTFLandCoreTestnet.s.sol`
###############################################################################

TARGET_TESTNET=arbitrum_sepolia

###############################################################################
# CompetitorNFT + World ID (see `script/deploy/DeployCTFLandCoreTestnet.s.sol`)
###############################################################################

# mock = deploy MockWorldID (default). router = use WORLD_ID_ROUTER (official World ID table).
WORLD_ID_MODE=mock

# When WORLD_ID_MODE=router — WorldIDRouter on that chain (see World on-chain docs).
# WORLD_ID_ROUTER=0x...

# Must match your World Developer Portal app id + action / IDKit (default only OK with mock).
# WORLD_EXTERNAL_NULLIFIER_HASH=1

# Keystore non-interactive: export ETH_PASSWORD=... before `./script/deploy/deploy_both_testnets.sh`
