# World ID overview: https://docs.world.org/world-id/overview · App + action: https://developer.worldcoin.org/

NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=ctfland-competitor
NEXT_PUBLIC_WORLD_ACTION_DESCRIPTION=
NEXT_PUBLIC_COMPETITOR_NFT_ADDRESS=
NEXT_PUBLIC_SPONSOR_NFT_ADDRESS=
# Triage / Judge credential NFTs (optional — defaults from `lib/contract-addresses.json` per chain)
NEXT_PUBLIC_TRIAGE_NFT_ADDRESS=
NEXT_PUBLIC_JUDGE_NFT_ADDRESS=
# Optional: RegistryMirror on the *peer* protocol chain (Fuji ↔ Arbitrum Sepolia) for CCIP mirror UI
NEXT_PUBLIC_REGISTRY_MIRROR_ADDRESS=
# CCIPRegistryPassport on the *primary* chain (`NEXT_PUBLIC_CHAIN_ID`) — enables /mirror ops UI
NEXT_PUBLIC_CCIP_REGISTRY_PASSPORT_ADDRESS=
# CCIPRegistryMirrorReceiver on the *peer* chain — checklist + optional deep links
NEXT_PUBLIC_CCIP_REGISTRY_MIRROR_RECEIVER_ADDRESS=
# Override ProtocolTreasuryVault per chain (optional — defaults from contract-addresses.json)
NEXT_PUBLIC_PROTOCOL_TREASURY_43113=
NEXT_PUBLIC_PROTOCOL_TREASURY_421614=
# Server wallet with `credentialVerifier` on TriageNFT & JudgeNFT — used to mint after OTP (keep secret)
VERIFIER_PRIVATE_KEY=
# Set to true in dev/demo to return OTP in `/api/credentials/start` JSON (real X DMs need X API)
CREDENTIALS_DEMO_REVEAL_OTP=
# Registry block when deployed — required for “latest CTF ID from events” (2048-block log chunks). Optional: NEXT_PUBLIC_REGISTRY_DEPLOY_BLOCK applies to any chain.
NEXT_PUBLIC_REGISTRY_DEPLOY_BLOCK=
NEXT_PUBLIC_REGISTRY_DEPLOY_BLOCK_43113=
NEXT_PUBLIC_REGISTRY_DEPLOY_BLOCK_421614=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
